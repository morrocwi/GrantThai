{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/morrocwi/GrantThai/spec/mcp/tools.schema.json",
  "title": "GrantThai MCP tools (implemented in v0.1, grantthai.mcp)",
  "description": "The MCP tool surface, a one-to-one wrapper over the same library functions the CLI uses (grantthai.api_py). Implemented in src/grantthai/mcp (docs/mcp.md); the `examples` entry below is the implemented tool list and tests/mcp checks the server against it. Hard rules: (1) no MCP tool may set any field's status above DRAFT (spec/common/status_permissions.yaml, hard_ceiling); (2) no MCP tool can submit anything to NRIIS or any fund; (3) validation over MCP is REPORT-ONLY (status_effect: none); (4) every value written over MCP is recorded as AI-assisted and can never be provenance_class SOURCE. (5) every value written over MCP records the AI tool (name, version, stage) in authoring.ai_use_declaration.tools; it never sets declaration_confirmed_by_human, which only the researcher sets (docs/policy/ai-use-ceiling.md). The CLI and MCP share the same checking code, so the findings are identical.",
  "type": "object",
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "wraps_cli_command",
          "max_status_ceiling",
          "status_effect",
          "can_submit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "wraps_cli_command": {
            "type": "string",
            "description": "Must name an existing human CLI command (spec/common/parity.yaml requires a tested human equivalent)."
          },
          "max_status_ceiling": {
            "type": "string",
            "const": "DRAFT"
          },
          "status_effect": {
            "type": "string",
            "enum": [
              "none",
              "draft_only"
            ],
            "description": "none = report-only, persists nothing; draft_only = may write field values at status DRAFT or below."
          },
          "can_submit": {
            "type": "boolean",
            "const": false
          },
          "input_schema_ref": {
            "type": "string"
          },
          "output_schema_ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "tools": [
        {
          "name": "grantthai_new_project",
          "wraps_cli_command": "grantthai init",
          "max_status_ceiling": "DRAFT",
          "status_effect": "draft_only",
          "can_submit": false,
          "input_schema_ref": "../project/project.schema.json",
          "output_schema_ref": "../project/project.schema.json"
        },
        {
          "name": "grantthai_list_fields",
          "wraps_cli_command": "grantthai fields",
          "max_status_ceiling": "DRAFT",
          "status_effect": "none",
          "can_submit": false,
          "output_schema_ref": "../../registry/fields.jsonl"
        },
        {
          "name": "grantthai_set_field",
          "wraps_cli_command": "grantthai set",
          "max_status_ceiling": "DRAFT",
          "status_effect": "draft_only",
          "can_submit": false,
          "input_schema_ref": "../project/project.schema.json",
          "output_schema_ref": "../project/project.schema.json"
        },
        {
          "name": "grantthai_validate",
          "wraps_cli_command": "grantthai validate",
          "max_status_ceiling": "DRAFT",
          "status_effect": "none",
          "can_submit": false,
          "input_schema_ref": "../project/project.schema.json",
          "output_schema_ref": "../common/validation_report.schema.json"
        },
        {
          "name": "grantthai_explain",
          "wraps_cli_command": "grantthai explain",
          "max_status_ceiling": "DRAFT",
          "status_effect": "none",
          "can_submit": false,
          "output_schema_ref": "../../validators/rules.yaml"
        },
        {
          "name": "grantthai_build",
          "wraps_cli_command": "grantthai build",
          "max_status_ceiling": "DRAFT",
          "status_effect": "none",
          "can_submit": false,
          "input_schema_ref": "../project/project.schema.json",
          "output_schema_ref": "../output/nriis-submission.contract.md"
        }
      ]
    }
  ]
}

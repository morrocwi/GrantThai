{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/morrocwi/GrantThai/spec/routes/placement.schema.json",
  "title": "GrantThai route placement (routes/<id>/placement.yaml)",
  "description": "Draft 0.1.0. The field -> section order of one route's output body, the route-level analogue of mappings/nriis/section_to_tab.yaml. Every field id must exist in registry/fields.jsonl and appear at most once; the set of placed fields must equal the route's body selector in routes/INDEX.yaml (partition.body.<route>). Section titles are GrantThai's descriptive headings, never a venue's or a funder's; title_th is NEEDS_INPUT until a person writes it. A filled registry field that is not placed is listed in a 'records not placed' appendix (not_placed_policy: appendix), never dropped silently.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "route",
    "not_placed_policy",
    "sections"
  ],
  "properties": {
    "schema": {
      "const": "grantthai.placement.v0"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-draft)?$"
    },
    "route": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "not_placed_policy": {
      "type": "string",
      "enum": [
        "appendix"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title_en",
          "title_th",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title_en": {
            "type": "string",
            "minLength": 1
          },
          "title_th": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "object",
            "description": "Optional condition on a work-object value, e.g. {field_id: ARTICLE.META.KIND, in: [empirical_research]}. A section whose condition is false is omitted from the body.",
            "required": [
              "field_id",
              "in"
            ],
            "properties": {
              "field_id": {
                "type": "string"
              },
              "in": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(PROFILE|FUND|CORE|METHOD|WORK|GEO|BUDGET|COMP|READY|RESULTS|DOC|AUDIT|BRIDGE|ARTICLE)(\\.[A-Z0-9_]+){2,}$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

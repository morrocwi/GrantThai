{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/morrocwi/GrantThai/spec/mappings/labels.schema.json",
  "title": "GrantThai candidate NRIIS labels (mappings/nriis/labels@<edition>.yaml)",
  "description": "Draft. Candidate Thai labels and code lists read from public source documents (docs/sources.md). Every entry is a CANDIDATE and NEEDS_VERIFICATION; none is declared official (founder ruling K14). Never sourced from the screenshot-derived readout.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "status",
    "status_marker",
    "sources",
    "tab_labels",
    "field_labels"
  ],
  "properties": {
    "schema": {
      "const": "grantthai.nriis_labels.v0"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "const": "CANDIDATE"
    },
    "status_marker": {
      "const": "NEEDS_VERIFICATION"
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^SD-[0-9]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "edition",
          "derived_from"
        ],
        "properties": {
          "edition": {
            "type": "string"
          },
          "derived_from": {
            "type": "string",
            "pattern": "^sourcedoc/SD-[0-9]+@sha256:[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "tab_labels": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "GENERAL",
          "PROJECT",
          "WORKPLAN",
          "UTILIZATION",
          "ATTACHMENTS"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "label_th",
          "source"
        ],
        "properties": {
          "label_th": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "required": [
              "doc",
              "pages"
            ],
            "properties": {
              "doc": {
                "type": "string",
                "pattern": "^SD-[0-9]+$"
              },
              "pages": {
                "type": "string"
              },
              "item": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "field_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label_th",
          "source"
        ],
        "properties": {
